// Single-Tenant Dienstplan-Tool
// Standard: PostgreSQL (lokal via Docker, in der Cloud z. B. Neon / Supabase / Railway)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum EmployeeSite {
  CRUSH
  CAPPUCONE
  SHARED
}

enum VacationLedgerKind {
  /// Bestehender Saldo beim ersten Ledger-Lauf / neuer Mitarbeiter
  OPENING_MIGRATION
  /// Gesetzliche Aufstockung (AT §2 vereinfacht) seit Cutover-Datum — Legacy, nicht mehr gebucht
  STATUTORY_ACCRUAL
  /// Monatsgutschrift: Jahresurlaub ÷ 12 (Jahresurlaub aus Arbeitstagen/Woche)
  MONTHLY_CONTRACT_ACCRUAL
  /// Anpassung beim Speichern des Dienstplans (Plan/Ist „U“)
  CONSUMPTION_ROTA
  /// Manuell im Stammdaten-Formular geändert
  MANUAL_ADJUSTMENT
}

model Employee {
  id                     String       @id @default(cuid())
  name                   String
  /// Personalnummer (Stammblatt / Monatsübersicht)
  personalNumber         String       @default("")
  /// Eintritt (optional)
  entryDate              DateTime?    @db.Date
  /// Austritt (optional)
  exitDate               DateTime?    @db.Date
  /// Crush, CappuCone oder beide Standorte (im Dienstplan beider Filialen sichtbar)
  workSite               EmployeeSite @default(SHARED)
  contractHoursPerWeek   Float
  workDaysPerWeek        Int
  startBalanceHours      Float        @default(0)
  vacationDaysOpen       Float        @default(0)
  /// Jahresurlaub in Arbeitstagen (Cache; immer aus workDaysPerWeek abgeleitet: 5 Wo. × min(Tage/Wo., 6)).
  annualVacationDays     Float        @default(25)
  /// Zeilenreihenfolge im Dienstplan (Crush) — niedriger = weiter oben
  planSortOrderCrush     Int          @default(0)
  /// Zeilenreihenfolge im Dienstplan (CappuCone)
  planSortOrderCappucone Int          @default(0)
  holidayRegion          String       @default("AT-Salzburg")
  active                 Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  shiftCells        ShiftCell[]
  timeAccountLines  TimeAccountLine[]
  contracts         EmployeeContract[]
  vacationLedgers   VacationLedger[]
}

/// Nachvollziehbare Urlaubs-Buchungen (Saldo = Summe amount; siehe references.md)
model VacationLedger {
  id            String               @id @default(cuid())
  employeeId    String
  employee      Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())
  effectiveDate DateTime             @db.Date
  amount        Float
  kind          VacationLedgerKind
  note          String               @default("")
  /// Kalendermonat der Gutschrift, z. B. "2026-02" (nur MONTHLY_CONTRACT_ACCRUAL)
  accrualPeriod String?

  @@index([employeeId])
  @@index([employeeId, kind])
  @@index([employeeId, accrualPeriod])
}

/// Vertragsstände (Wechsel z. B. zum 1. eines Monats). Mehrere Zeilen pro Mitarbeiter, sortiert nach effectiveFrom.
model EmployeeContract {
  id                   String   @id @default(cuid())
  employeeId           String
  employee             Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Gültig ab diesem Kalendertag (inkl.). In der Praxis oft Monatserster.
  effectiveFrom        DateTime @db.Date
  contractHoursPerWeek   Float
  workDaysPerWeek        Int

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId])
}

enum WeekStatus {
  DRAFT
  CLOSED
}

enum WorkSite {
  CRUSH
  CAPPUCONE
}

model WorkWeek {
  id         String     @id @default(cuid())
  weekStart  DateTime
  site       WorkSite   @default(CRUSH)
  status     WeekStatus @default(DRAFT)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  shiftCells       ShiftCell[]
  timeAccountLines TimeAccountLine[]

  @@unique([weekStart, site])
}

enum ShiftLayer {
  PLAN
  ACTUAL
}

model ShiftCell {
  id          String     @id @default(cuid())
  workWeekId  String
  employeeId  String
  dayIndex    Int
  layer       ShiftLayer
  rawValue    String     @default("")
  /// Freitext pro Schicht (z. B. Tätigkeit); unabhängig von Zeit-Parsing
  note        String     @default("")

  workWeek WorkWeek @relation(fields: [workWeekId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workWeekId, employeeId, dayIndex, layer])
  @@index([workWeekId, employeeId])
}

model TimeAccountLine {
  id               String   @id @default(cuid())
  employeeId       String
  workWeekId       String
  weeklyDeltaHours Float
  balanceAfter     Float
  source           String   @default("IST_CLOSED")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workWeek WorkWeek @relation(fields: [workWeekId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([employeeId, workWeekId])
  @@index([employeeId])
}

model Holiday {
  id              String   @id @default(cuid())
  date            DateTime
  name            String
  region          String
  /// Von der Organisation aktiviert – nur diese erscheinen im Dienstplan
  includedInPlan  Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([date, region])
  @@index([region])
  @@index([includedInPlan])
}

/// Schulferien / unterrichtsfreie Zeiträume (Salzburg AT, Bayern DE) — im Dienstplan wie Feiertage markierbar
model SchoolBreak {
  id              String   @id @default(cuid())
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  name            String
  region          String
  includedInPlan  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([startDate, endDate, region, name])
  @@index([region])
  @@index([includedInPlan])
}
