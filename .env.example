# Kopiere nach .env (und optional .env.local für Next)

# PostgreSQL (lokal mit docker compose: siehe docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dienstplan"

# Ein Planer-Login
PLANNER_PASSWORD="change-me-in-production"

# Mindestens 16 Zeichen (Produktion: starkes Geheimnis)
SESSION_SECRET="dev-secret-replace-with-openssl-rand-base64-32"

# Optional: GET/POST /api/cron/vacation-accrual mit Authorization: Bearer … oder ?secret=
# (Monatsgutschrift Urlaub, nur am 1. des Monats UTC; ohne Variable antwortet die Route 401)
# Auf Vercel: CRON_SECRET setzen — Cron am 1. um 05:05 UTC (siehe DEPLOYMENT.md)
CRON_SECRET=""

# Stichtag Go-Live / Systemwechsel (YYYY-MM-DD): Eröffnung des Urlaubs-Journals für Bestands-MA
# am Cutover; Eintritt nach Cutover → Eröffnung am Eintrittsdatum. Ohne Variable: bisheriges Verhalten.
VACATION_LEDGER_CUTOVER_DATE=
